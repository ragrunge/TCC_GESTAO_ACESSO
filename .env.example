# Copiar para .env (que NÃO é distribuído) e preencher. Nenhum valor real aqui.
#   cp .env.example .env
# Senhas de banco: alfanuméricas, porque entram em URL de conexão (sem / + =):
#   openssl rand -base64 32 | tr -d '/+=\n'
# Chaves da aplicação: base64 normal:
#   openssl rand -base64 32

# --- Postgres (docker compose) e bootstrap de roles (db/bootstrap/00_roles.sh) ---
POSTGRES_PASSWORD=
APP_MIGRATOR_PASSWORD=
APP_RW_PASSWORD=

# Porta do Postgres no host (127.0.0.1). Mude se já houver um Postgres local na 5432.
DB_HOST_PORT=5432

# --- Segredos da aplicação (nunca no banco nem no dump) ---
# HMAC do CPF (documento_busca). 32+ bytes em base64. NÃO é rotacionável sem recadastro (ver db/README.md).
# A API também deriva dela (HKDF) a subchave do limite de login; trocá-la só zera os contadores de tentativa.
PORTARIA_HMAC_CPF_KEY=
# KEK dos documentos (AES-256-GCM, envelope com DEK por arquivo). 32 bytes em base64.
PORTARIA_KEK=
PORTARIA_KEK_VERSAO=1

# --- API: ambiente, sessão e cookie (spec §5.1). Valores sugeridos entre parênteses; nada aqui é segredo, exceto o seed ---
# dev | producao. Em producao, COOKIE_SECURE=false derruba o boot, e o seed cria usuários com troca de senha obrigatória.
PORTARIA_AMBIENTE=
# true | false (só essas grafias). false SÓ em http://localhost (dev); produção é https e exige true.
COOKIE_SECURE=
# false (sem proxy, dev) | número de proxies confiáveis na frente da API (produção: ver spec §14, decisão de deploy).
TRUST_PROXY=
# Origens exatas para CORS com credenciais, separadas por vírgula (ex. dev sem proxy do Vite: http://localhost:5173).
# Vazio = CORS desligado (produção: mesma origem via rewrite da Vercel).
CORS_ORIGENS=
# Expiração absoluta (720 = 12 h) e por inatividade (30), em minutos.
SESSAO_ABSOLUTA_MIN=
SESSAO_INATIVIDADE_MIN=
# Limite de login (spec §5.1 e §14 nº 27). Vazio = padrão: 10 falhas por login (3 a 50) e 30 por IP (3 a 500) numa
# janela de 15 min, com bloqueio de 15 min. O IP é mais folgado porque a guarita sai por um único IP (NAT).
LOGIN_MAX_FALHAS_LOGIN=
LOGIN_MAX_FALHAS_IP=
LOGIN_JANELA_MIN=
LOGIN_BLOQUEIO_MIN=
# Senha dos 4 usuários do seed de dev (12+ caracteres, fora da lista comum). Só dev; em produção deixe vazio.
#   openssl rand -base64 18 | tr -d '/+=\n'
SEED_SENHA_DEV=

# As URLs de conexão (DATABASE_URL da API como app_rw, DATABASE_URL_MIGRATOR do migrate como
# app_migrator) são montadas no docker-compose.yml a partir das senhas acima, com host "db".
# Fora do Docker (npm run db:migrate / start:dev no host), exporte-as apontando para 127.0.0.1:5432.
