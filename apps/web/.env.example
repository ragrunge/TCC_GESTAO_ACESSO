# mock (padrão) ou http
VITE_API_MODE=mock
# Base da API no modo http. Deixe relativa (mesma origem): em dev o proxy do Vite repassa /api para a API local,
# em produção o rewrite da Vercel repassa para a VPS. Base em outra origem quebra o cookie SameSite=Strict.
VITE_API_URL=/api/v1
# Alvo do proxy do Vite (variável de shell lida pelo vite.config.ts; sem prefixo VITE_, não entra no bundle)
# API_PROXY_ALVO=http://127.0.0.1:3000
