meta {
  name: auditoria / exportar
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/auditoria/exportacoes
  body: json
  auth: none
}

body:json {
  {
    "eventoId": "{{eventoId}}",
    "de": 0,
    "ate": 0,
    "unidadeId": "{{unidadeId}}",
    "pessoaId": "{{pessoaId}}",
    "pessoa": "exemplo",
    "placa": "ABC1D23",
    "operadorId": "{{operadorId}}",
    "tipo": "entrada",
    "meio": "interfone",
    "somenteExcecoes": false,
    "somenteRetroativos": false,
    "excluirTipos": [
      "entrada"
    ]
  }
}

docs {
  Permissão: `auditoria.exportar`
}
