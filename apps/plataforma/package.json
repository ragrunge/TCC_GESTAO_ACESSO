{
  "name": "@portaria/plataforma",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "App do Master (administração do SaaS): login com e-mail e senha, licenças, criação de condomínio e módulos. Servido em /admin do mesmo site (projeto Vercel) do apps/web, como bundle separado.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:admin": "tsc --noEmit && vite build --outDir ../web/dist/admin --emptyOutDir",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@portaria/domain": "*",
    "@tanstack/react-query": "^5.104.4",
    "axios": "^1.20.0",
    "lucide-react": "^1.55.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.1",
    "jsdom": "^30.1.2",
    "postcss": "^8.5.29",
    "tailwindcss": "3.4",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}
