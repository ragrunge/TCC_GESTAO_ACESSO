@startuml uc2_administracao
' Casos de uso de cadastro e governança — fonte: 01_requisitos.md, seção 12
!include _estilo.iuml
title Diagrama 2 — Cadastro, vínculo e regras de acesso (M1, M2)

actor "Porteiro" as P
actor "Administração" as A
actor "Síndico" as S
S -|> A

rectangle "Sistema de Controle de Acesso" {
  usecase "UC10 Cadastrar\nautorização prévia" as UC10
  usecase "UC11 Cadastrar restrição" as UC11
  usecase "UC12 Aprovar restrição\npara todo o condomínio" as UC12
  usecase "UC13 Manter unidades,\nveículos e funcionários" as UC13
  usecase "UC14 Manter cadastro\nde pessoas" as UC14
  usecase "UC15 Solicitar vínculo\ncom unidade" as UC15
  usecase "UC16 Registrar conferência\ndo comprovante" as UC16
  usecase "UC17 Aprovar ou rejeitar\nvínculo" as UC17
  usecase "UC18 Importar planilha\nde moradores" as UC18
  usecase "UC19 Gerenciar usuários\ndo sistema" as UC19
}

P -- UC10
P -- UC11
A -- UC10
A -- UC11
A -- UC13
A -- UC14
A -- UC15
A -- UC17
A -- UC18
S -- UC12
S -- UC19

UC12 ..> UC11 : <<extend>>
UC15 ..> UC16 : <<include>>
@enduml
