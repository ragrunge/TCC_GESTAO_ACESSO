# PRODUÇÃO (VPS). Copiar para .env NA PASTA DO CLONE da VPS e preencher lá, com chmod 600. Nenhum valor real aqui,
# e o .env nunca volta para o git. Passo a passo: docs/deploy.md.
#   cp .env.producao.example .env && chmod 600 .env
#
# Gerar os segredos NA VPS (o valor não passa por chat, e-mail nem terminal de outra máquina):
#   senhas de banco (entram em URL, então sem / + =):  openssl rand -base64 32 | tr -d '/+=\n'
#   chaves da aplicação (base64 de 32 bytes):          openssl rand -base64 32
# Guarde uma cópia de PORTARIA_HMAC_CPF_KEY e de PORTARIA_KEK FORA da VPS (cofre de senhas): elas não estão no
# backup do banco, e sem elas o restore perde a busca por CPF e os anexos (docs/deploy.md, seção Restore).

# --- Compose: faz `docker compose ...` nesta pasta usar SEMPRE o arquivo de produção (não editar) ---
COMPOSE_FILE=docker-compose.prod.yml

# --- Banco (bootstrap de roles e URLs de conexão montadas no compose) ---
POSTGRES_PASSWORD=
APP_MIGRATOR_PASSWORD=
APP_RW_PASSWORD=

# --- Segredos da aplicação (não estão no dump) ---
# SaaS (F2): as chaves do piloto vêm do banco plataforma (embrulhadas pela PORTARIA_CHAVE_MESTRA). Estas três ficam
# aqui SÓ durante a transição: a API as compara no boot com as da plataforma e recusa subir se diferirem. Esvaziar ao
# fim da transição (a cópia do cofre continua sendo a recuperação).
# HMAC do CPF: NÃO rotacionável sem recadastro (db/README.md). Perder = perder a busca por CPF dos cadastros.
PORTARIA_HMAC_CPF_KEY=
# KEK dos anexos (AES-256-GCM). Perder = anexos ilegíveis para sempre.
PORTARIA_KEK=
PORTARIA_KEK_VERSAO=

# --- SaaS (docs/deploy.md, seções 12 e 13). Obrigatórias para a API desde a F2 (banco plataforma + chave mestra). ---
# Gerar NA VPS, como as outras:
#   APP_PLATAFORMA_PASSWORD:  openssl rand -base64 32 | tr -d '/+=\n'
#   PORTARIA_CHAVE_MESTRA:    openssl rand -base64 32   (versão 1). Cópia no cofre ANTES de usar: perder = perder as
#                             chaves de todos os condomínios. Nunca igual à KEK nem à HMAC.
APP_PLATAFORMA_PASSWORD=
PORTARIA_CHAVE_MESTRA=
PORTARIA_CHAVE_MESTRA_VERSAO=
# Provisionamento de condomínio novo (docs/deploy.md, seção 16): senha do role app_provisionador (CREATE DATABASE),
# usada só pelo serviço provisionar-cli. Gerar como as outras: openssl rand -base64 32 | tr -d '/+=\n'
APP_PROVISIONADOR_PASSWORD=
# App do Master, F5 entrega 1 (docs/deploy.md, seção 18). Serviço provisionador (perfil provisionar, rede interna) chamado
# pela API em POST /plataforma/condominios. Juntas; vazias = criação pela tela desligada (503), a CLI continua valendo.
#   PROVISIONADOR_URL:   http://provisionador:3200
#   PROVISIONADOR_TOKEN: openssl rand -base64 48 | tr -d '/+=\n'   (32+ caracteres; só a API e o provisionador o leem)
PROVISIONADOR_URL=
PROVISIONADOR_TOKEN=
# Transição da F2 (SAAS-05): login sem código do condomínio e cookie de sessão antigo = piloto. Vazio = true.
SAAS_PILOTO_PADRAO=

# --- Rede ---
# Porta da API em 127.0.0.1 na VPS, para o proxy. Padrão 3100 (o Tobe usa 3333). Vazio = 3100.
API_HOST_PORT=
# Saltos de proxy confiáveis na frente da API (docs/deploy.md, seção TRUST_PROXY):
#   2 = navegador -> Vercel (rewrite /api) -> proxy da VPS -> API   (topologia desta fase)
#   1 = navegador -> proxy da VPS -> API (sem Vercel no caminho, ex.: domínio próprio api.)
# Errado para MAIS, o IP vira forjável por quem chama a VPS direto; para MENOS, todos os usuários viram o IP da
# borda da Vercel e 30 falhas de qualquer um bloqueiam o login de todos.
TRUST_PROXY=

# --- Sessão e limites (vazio = padrão da spec: 720 / 30 min; 10 falhas por login e 30 por IP em 15 min) ---
SESSAO_ABSOLUTA_MIN=
SESSAO_INATIVIDADE_MIN=
LOGIN_MAX_FALHAS_LOGIN=
LOGIN_MAX_FALHAS_IP=
LOGIN_JANELA_MIN=
LOGIN_BLOQUEIO_MIN=
IMPORTACAO_PRAZO_LEGADO_DIAS=
RETENCAO_ANEXO_OCORRENCIA_ANOS=

# --- Âncora externa do selo (spec §4.6) ---
# Vazio = github (o GitHub Actions lê GET /api/v1/auditoria/selos/publico). Para somar o e-mail: github,email e
# preencher as ANCORA_* abaixo (SMTP com TLS; a API recusa TLS=nenhum em produção).
ANCORA_DESTINOS=
ANCORA_EMAILS=
ANCORA_REMETENTE=
ANCORA_SMTP_HOST=
ANCORA_SMTP_PORTA=
ANCORA_SMTP_TLS=
ANCORA_SMTP_USUARIO=
ANCORA_SMTP_SENHA=

# --- Build ---
# Tag das imagens tcc-portaria-api/-migrate. Vazio = "atual". Para rollback, use o sha curto do commit (docs/deploy.md).
API_TAG=
